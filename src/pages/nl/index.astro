---
/**
 * NL homepage. Body lives in components/growth/Home.astro,
 * copy in data/site.ts, FAQ (also used for FAQPage schema) in data/home-faq.json.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Home from '../../components/growth/Home.astro';
import { homeCopy } from '../../data/site';
import faqs from '../../data/home-faq.json';

const c = homeCopy.nl;
const faqData = faqs.nl.map((f) => ({ question: f.q, answer: f.a }));
---

<BaseLayout title={c.title} description={c.description} locale="nl" dateModified="2026-11-17" schemaType="WebPage" faqData={faqData}>
  <Home locale="nl" />
</BaseLayout>
