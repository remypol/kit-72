---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import ListSignup from '../../../../components/growth/ListSignup.astro';
import Breadcrumbs from '../../../../components/ui/Breadcrumbs.astro';
import KitBuilder from '../../../../components/tools/KitBuilder';
---

<BaseLayout
  title="Noodpakket samensteller: jouw checklist in 2 minuten"
  description="Stel je eigen noodpakket-checklist samen: kies je situatie, vink af wat je al in huis hebt en zie wat er nog ontbreekt. Gratis, zonder account, te printen."
  locale="nl"
  dateModified="2026-11-18"
  schemaType="SoftwareApplication"
  schemaData={{
    '@type': 'WebApplication',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  }}
>
  <section class="py-12 md:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="mb-8">
        <Breadcrumbs locale="nl" />
        <h1 class="text-4xl font-bold mb-4">Noodpakket samenstellen</h1>
        <p class="text-xl text-(--color-text-secondary)">
          Maak een gepersonaliseerde checklist voor jouw gezin en situatie. Kies je scenario, vink items af en deel of print je pakket.
        </p>
      </div>

      <KitBuilder locale="nl" client:load />
    </div>
  </section>
  <ListSignup locale="nl" source="builder" variant="band" />
</BaseLayout>
