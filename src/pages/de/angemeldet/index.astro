---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { routes } from '../../../data/site';
const r = routes.de;
---

<BaseLayout title="Du bist angemeldet" locale="de" noIndex>
  <section class="thanks">
    <div data-state="ok">
      <h1>Deine Adresse ist bestätigt</h1>
      <p>Deine Liste ist unterwegs in dein Postfach. In den nächsten zwei Wochen folgen drei kurze Tipps, und in sechs Monaten eine Erinnerung, Wasser, Lebensmittel und Batterien zu prüfen.</p>
      <a href={r.builder} class="btn btn-primary btn-lg">Weiter mit meiner Liste</a>
    </div>
    <div data-state="error" hidden>
      <h1>Beim Bestätigen ist etwas schiefgegangen</h1>
      <p>Deine Adresse wurde nicht gespeichert. Fordere deine Liste noch einmal an; das dauert eine halbe Minute.</p>
      <a href={r.home} class="btn btn-primary btn-lg">Erneut anfordern</a>
    </div>
  </section>
</BaseLayout>

<script>
  if (new URLSearchParams(location.search).get('status') === 'error') {
    document.querySelector<HTMLElement>('[data-state="ok"]')!.hidden = true;
    document.querySelector<HTMLElement>('[data-state="error"]')!.hidden = false;
  }
</script>

<style>
  .thanks {
    max-width: 40rem;
    margin-inline: auto;
    padding: var(--space-16) var(--space-4) var(--space-24);
  }
  .thanks h1 {
    font-size: clamp(2rem, 4.4vw, 2.8rem);
  }
  .thanks p {
    margin-block: var(--space-4) var(--space-6);
    font-size: 1.15rem;
    color: var(--color-text-secondary);
  }
</style>
