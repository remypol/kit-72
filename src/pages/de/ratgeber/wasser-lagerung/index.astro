---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import HeroImage from '../../../../components/content/HeroImage.astro';
import Breadcrumb from '../../../../components/layout/Breadcrumb.astro';
import Icon from '../../../../components/ui/Icon.astro';
import RelatedContent from '../../../../components/content/RelatedContent.astro';

const relatedItems = [
  {
    title: 'Lebensmittel lagern',
    href: '/de/ratgeber/lebensmittel-lagerung/',
    description: 'Langlebige Nahrung für Notfälle richtig aufbewahren.',
    type: 'guide' as const,
    icon: 'UtensilsCrossed'
  },
  {
    title: 'Wasserausfall-Szenario',
    href: '/de/szenarien/wasserausfall/',
    description: 'So bereitest du dich auf Unterbrechungen der Wasserversorgung vor.',
    type: 'scenario' as const,
    icon: 'AlertTriangle'
  },
  {
    title: 'Wasserspeicher',
    href: '/de/produkte/wasserspeicher/',
    description: 'Empfohlene Kanister und Behälter für Trinkwasser.',
    type: 'product' as const,
    icon: 'Droplet'
  },
  {
    title: 'Wasser-Rechner',
    href: '/de/tools/wasser-rechner/',
    description: 'Berechne deinen individuellen Wasserbedarf.',
    type: 'tool' as const,
    icon: 'Calculator'
  }
];

const faqs = [
  {
    question: 'Wie lange ist selbst abgefülltes Leitungswasser haltbar?',
    answer: 'Dafür gibt es keine verlässliche Angabe. Die Bundesanstalt für Landwirtschaft und Ernährung empfiehlt deshalb, für den Notvorrat Wasser aus dem Handel zu lagern, am besten in Glas- oder PET-Flaschen. Selbst abgefülltes Leitungswasser eignet sich eher als Brauchwasser.',
  },
  {
    question: 'Wie viel Wasser sollte man pro Person lagern?',
    answer: 'Das BBK empfiehlt 2 Liter Flüssigkeit pro Person und Tag. Für 72 Stunden sind das 6 Liter pro Person, für 10 Tage 20 Liter.',
  },
  {
    question: 'Welche Behälter eignen sich zum Lagern von Trinkwasser?',
    answer: 'Am einfachsten ist original verschlossenes Mineralwasser. Für Leitungswasser eignen sich lebensmittelechte Kanister aus HDPE. Nicht geeignet sind Behälter, in denen Milch, Saft oder Chemikalien waren.',
  },
];
---

<BaseLayout
  title="Wasser lagern: Menge, Behälter und Haltbarkeit"
  description="Trinkwasser für den Notfall lagern: wie viel pro Person, welche Behälter, wie lange abgefülltes Leitungswasser haltbar ist und wie du Wasser haltbar machst."
  faqData={faqs}
  dateModified="2026-11-17"
  locale="de"
  dateModified="2026-11-18"
  schemaType="Article"
>
  <section class="py-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <Breadcrumb items={[{ label: 'Ratgeber', href: '/de/ratgeber/' }, { label: 'Wasser lagern' }]} class="mb-4" locale="de" />
      <h1 class="text-4xl font-bold mb-6">Wasser lagern für den Notfall</h1>

      <div class="mb-8">
        <HeroImage
          src="/images/shared/water-storage.webp"
          alt="Zwei gestapelte Wasserkanister, Flaschen, ein Wasserfilter mit Pumpe und Entkeimungstabletten"
          priority={true}
        />
      </div>

      <div class="prose prose-lg">
        <p class="lead">
          Wasser ist der wichtigste Bestandteil deines Notfallpakets. Das BBK empfiehlt
          <strong>2 Liter Flüssigkeit pro Person und Tag</strong>, davon etwa ein halber Liter
          zum Kochen. Wasser zum Waschen kommt dazu.
        </p>

        <!-- Quick Reference Card -->
        <div class="card p-6 my-8 bg-(--color-bg-tertiary) not-prose">
          <h3 class="text-lg font-semibold mb-4 flex items-center gap-2">
            <Icon name="Droplet" size={20} class="text-(--color-accent-primary)" />
            Schnellübersicht: Wasserbedarf
          </h3>
          <div class="grid sm:grid-cols-2 gap-4">
            <div class="p-4 bg-(--color-bg-secondary) rounded-lg">
              <p class="text-2xl font-bold text-(--color-accent-primary)">6 Liter</p>
              <p class="text-sm text-(--color-text-secondary)">pro Person für 72 Stunden (3 Tage)</p>
            </div>
            <div class="p-4 bg-(--color-bg-secondary) rounded-lg">
              <p class="text-2xl font-bold text-(--color-accent-primary)">20 Liter</p>
              <p class="text-sm text-(--color-text-secondary)">pro Person für 10 Tage (BBK-Empfehlung)</p>
            </div>
          </div>
          <p class="text-sm text-(--color-text-muted) mt-4">
            <strong>Haustiere:</strong> 50-100ml pro kg Körpergewicht pro Tag
          </p>
        </div>

        <h2>Geeignete Behälter</h2>
        <ul>
          <li><strong>Originalverpacktes Mineralwasser</strong> — am sichersten und längsten haltbar</li>
          <li><strong>Lebensmittelechte Kanister</strong> — aus HDPE (Recyclingcode 2), BPA-frei</li>
          <li><strong>Edelstahlbehälter</strong> — langlebig, aber schwerer</li>
          <li><strong>Faltbare Wasserbeutel</strong> — platzsparend, aber weniger robust</li>
        </ul>

        <div class="card p-4 my-6 border-l-4 border-l-amber-500 bg-amber-50 dark:bg-amber-950/30 not-prose">
          <p class="text-sm">
            <strong>⚠️ Nicht verwenden:</strong> Milchflaschen, ehemalige Chemikalienbehälter,
            oder durchsichtige Plastikflaschen für Langzeitlagerung (Licht fördert Algenbildung).
          </p>
        </div>

        <h2>Wo lagern?</h2>
        <ul>
          <li><strong>Kühl</strong> — idealerweise unter 20°C (Keller, Abstellraum)</li>
          <li><strong>Dunkel</strong> — vor direktem Sonnenlicht geschützt</li>
          <li><strong>Sauber</strong> — nicht neben Chemikalien, Farben oder Reinigungsmitteln</li>
          <li><strong>Frostfrei</strong> — gefrorenes Wasser kann Behälter beschädigen</li>
        </ul>

        <h2>Wie viel Wasser für wie viele Personen?</h2>
        <p>
          Für 72 Stunden sind es 6 Liter pro Person, für die vom BBK empfohlenen 10 Tage 20 Liter.
          Ein Haushalt mit vier Personen braucht also 24 Liter für drei Tage und 80 Liter für zehn.
          Für jedes Haustier rechnest du etwa einen Liter für drei Tage dazu. Deinen genauen Bedarf
          zeigt der <a href="/de/tools/wasser-rechner/">Wasser-Rechner</a>.
        </p>

        <h2>Wie lange ist abgefülltes Leitungswasser haltbar?</h2>
        <p>
          Dafür gibt es keine verlässliche Angabe: Haltbarkeit und Wasserqualität hängen von Gefäß und
          Lagerung ab, und selbst abgefülltes Wasser kann verkeimen. Die Bundesanstalt für Landwirtschaft
          und Ernährung empfiehlt für den Trinkwasservorrat deshalb gekauftes Wasser in Flaschen.
          Füllst du trotzdem Kanister, zum Beispiel als Brauchwasser, achte auf Folgendes:
        </p>
        <ul>
          <li>Kanister vor dem Befüllen gründlich reinigen und randvoll füllen</li>
          <li>Dicht verschließen und das Abfülldatum auf den Kanister schreiben</li>
          <li>Kühl und dunkel lagern</li>
          <li>Beim Austausch das alte Wasser zum Gießen oder Putzen verwenden</li>
        </ul>

        <h2>Haltbarkeit im Überblick</h2>
        <p>
          Ungeöffnetes Flaschenwasser hält am längsten:
        </p>
        <ul>
          <li><strong>Mineralwasser (ungeöffnet):</strong> bis zum Mindesthaltbarkeitsdatum, in Glas etwa zwei Jahre, in PET etwa ein Jahr</li>
          <li><strong>Selbst abgefülltes Leitungswasser:</strong> keine verlässliche Haltbarkeit; eher als Brauchwasser nutzen</li>
          <li><strong>Nach Öffnung:</strong> innerhalb von 3-5 Tagen verbrauchen</li>
        </ul>

        <h2>Zusätzliche Sicherheit</h2>
        <div class="card p-6 my-8 bg-(--color-accent-subtle) not-prose">
          <p class="font-medium mb-2">💡 Backup-Lösungen</p>
          <p class="text-sm text-(--color-text-secondary) mb-4">
            Neben gelagertem Wasser solltest du diese Optionen haben:
          </p>
          <ul class="space-y-2 text-sm">
            <li class="flex items-start gap-2">
              <span class="text-(--color-accent-primary)">•</span>
              <span><strong>Wasserentkeimungstabletten</strong> — z.B. Micropur, 1 Tablette pro Liter</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-(--color-accent-primary)">•</span>
              <span><strong>Wasserfilter</strong> — Sawyer, LifeStraw für Notfälle unterwegs</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-(--color-accent-primary)">•</span>
              <span><strong>Abkochen</strong> — einmal sprudelnd aufkochen und mindestens 10 Minuten langsam abkühlen lassen (Umweltbundesamt)</span>
            </li>
          </ul>
        </div>

        <h2>Checkliste Wasserlagerung</h2>
        <ul>
          <li>☐ Mindestens 6 Liter pro Person für 3 Tage, besser 20 Liter für 10 Tage</li>
          <li>☐ Lebensmittelechte Behälter verwendet</li>
          <li>☐ Kühl, dunkel und frostfrei gelagert</li>
          <li>☐ Datum der Einlagerung notiert</li>
          <li>☐ Wasserbedarf für Haustiere eingeplant</li>
          <li>☐ Backup: Entkeimungstabletten vorhanden</li>
        </ul>
      </div>

      <!-- CTA -->
      <div class="mt-12 card p-6 bg-(--color-bg-tertiary)">
        <h3 class="font-semibold mb-2">Exakt berechnen?</h3>
        <p class="text-sm text-(--color-text-secondary) mb-4">
          Nutze unseren Wasser-Rechner für deinen individuellen Bedarf.
        </p>
        <a
          href="/de/tools/wasser-rechner/"
          class="inline-flex items-center gap-2 px-4 py-2 bg-(--color-accent-primary) text-(--color-bg-primary) font-medium rounded hover:bg-(--color-accent-hover) transition-colors"
        >
          <Icon name="Calculator" size={16} />
          Zum Wasser-Rechner
        </a>
      </div>

      <!-- Related Content -->
      <RelatedContent items={relatedItems} locale="de" />
    </div>
  </section>
</BaseLayout>
