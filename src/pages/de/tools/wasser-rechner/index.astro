---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/ui/Breadcrumbs.astro';
import WaterCalculator from '../../../../components/tools/WaterCalculator';
---

<BaseLayout
  title="Wasser-Rechner — Kit-72"
  description="Berechne, wie viel Wasser du für dein Notfallpaket brauchst. Interaktive Tool mit persönlicher Berechnung für deine Familie."
  locale="de"
  dateModified="2025-12-15"
  schemaType="SoftwareApplication"
  schemaData={{
    '@type': 'WebApplication',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  }}
>
  <section class="py-12 md:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="mb-8">
        <Breadcrumbs locale="de" />
        <h1 class="text-4xl font-bold mb-4">Wasser-Rechner</h1>
        <p class="text-xl text-(--color-text-secondary)">
          Berechne genau, wie viel Wasser du für deine Familie brauchst. Das BBK empfiehlt 2 Liter Trinkwasser pro Person pro Tag.
        </p>
      </div>

      <WaterCalculator locale="de" client:load />
    </div>
  </section>
</BaseLayout>
