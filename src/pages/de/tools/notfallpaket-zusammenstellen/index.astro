---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import ListSignup from '../../../../components/growth/ListSignup.astro';
import Breadcrumbs from '../../../../components/ui/Breadcrumbs.astro';
import KitBuilder from '../../../../components/tools/KitBuilder';
---

<BaseLayout
  title="Notfallpaket Zusammenstellen — Kit-72"
  description="Interaktive Tool zum Erstellen eines personalisierten Notfallpakets für deine Familie. Wähle dein Szenario, hake Artikel ab und exportiere deine Checkliste."
  locale="de"
  dateModified="2025-12-15"
  schemaType="SoftwareApplication"
  schemaData={{
    '@type': 'WebApplication',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  }}
>
  <section class="py-12 md:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="mb-8">
        <Breadcrumbs locale="de" />
        <h1 class="text-4xl font-bold mb-4">Notfallpaket Zusammenstellen</h1>
        <p class="text-xl text-(--color-text-secondary)">
          Erstelle eine personalisierte Checkliste für deine Familie und Situation. Wähle dein Szenario, hake Artikel ab und teile oder drucke dein Paket.
        </p>
      </div>

      <KitBuilder locale="de" client:load />
    </div>
  </section>
  <ListSignup locale="de" source="builder" variant="band" />
</BaseLayout>
