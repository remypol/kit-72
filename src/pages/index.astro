---
/**
 * Root page: language chooser and x-default hreflang target.
 *
 * Most visitors never see it. vercel.json redirects "/" to /nl/, /de/ or /es/
 * by the browser's first language, then by country; this page is what is left
 * for everyone else (and for search engines, which send no language header).
 * A small script repeats the language check for hosts without those rules.
 * "/?choose" always shows the chooser.
 */
import '../styles/global.css';
import Logo from '../components/ui/Logo.astro';

const languages = [
  { code: 'nl', href: '/nl/', name: 'Nederlands', line: 'Noodpakket samenstellen voor 72 uur' },
  { code: 'de', href: '/de/', name: 'Deutsch', line: 'Notvorrat für 72 Stunden zusammenstellen' },
  { code: 'es', href: '/es/', name: 'Español', line: 'Kit de emergencia para 72 horas' },
];

const title = 'Kit-72: your 72-hour emergency kit, built yourself';
const description = 'Work out what your household needs for 72 hours without help, and put the kit together yourself. Free guides and tools in Dutch, German and Spanish.';

const schemaData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Kit-72',
  alternateName: 'Kit 72',
  url: 'https://www.kit-72.com/',
  description,
  inLanguage: ['nl', 'de', 'es'],
  publisher: { '@type': 'Organization', name: 'Kit-72', url: 'https://www.kit-72.com/' },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://www.kit-72.com/" />
    <link rel="alternate" hreflang="x-default" href="https://www.kit-72.com/" />
    <link rel="alternate" hreflang="nl-NL" href="https://www.kit-72.com/nl/" />
    <link rel="alternate" hreflang="de-DE" href="https://www.kit-72.com/de/" />
    <link rel="alternate" hreflang="es-ES" href="https://www.kit-72.com/es/" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://www.kit-72.com/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://www.kit-72.com/images/og-default.jpg" />
    <meta property="og:site_name" content="Kit-72" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0a3d26" />
    <script is:inline>
      // Fallback for hosts without the edge redirect: go to the first supported browser language.
      (function () {
        if (/[?&]choose\b/.test(location.search)) return;
        var langs = navigator.languages || [navigator.language || ''];
        for (var i = 0; i < langs.length; i++) {
          var l = String(langs[i]).slice(0, 2).toLowerCase();
          if (l === 'nl' || l === 'de' || l === 'es') return location.replace('/' + l + '/');
        }
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
  </head>
  <body>
    <main class="hub">
      <p class="hub__brand"><Logo size={44} /><span class="brand-word">Kit-72</span></p>
      <h1>What does your household need for 72 hours?</h1>
      <p class="hub__lead">Work it out and put the kit together yourself. Choose your language.</p>
      <ul class="hub__list">
        {languages.map((l) => (
          <li>
            <a href={l.href} hreflang={l.code} lang={l.code}>
              <span class="hub__name">{l.name}</span>
              <span class="hub__line">{l.line}</span>
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
            </a>
          </li>
        ))}
      </ul>
      <p class="hub__foot">Kit-72 sells nothing itself. It is funded by links to shops, which are marked on the pages that carry them.</p>
    </main>
  </body>
</html>

<style>
  .hub {
    max-width: 40rem;
    margin-inline: auto;
    padding: 12vh var(--space-5) var(--space-16);
  }
  .hub__brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-10);
  }
  .hub h1 {
    font-size: clamp(2rem, 6vw, 3rem);
    max-width: 16ch;
  }
  .hub__lead {
    margin-top: var(--space-4);
    font-size: 1.15rem;
    color: var(--color-text-secondary);
  }
  .hub__list {
    margin-top: var(--space-8);
    border-top: 2px solid var(--color-text-primary);
  }
  .hub__list a {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas: 'name go' 'line go';
    align-items: center;
    padding: var(--space-4) var(--space-2);
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text-primary);
  }
  .hub__list a:hover {
    background: var(--color-bg-secondary);
  }
  .hub__name {
    grid-area: name;
    font-family: var(--font-display);
    font-stretch: 110%;
    font-weight: 750;
    font-size: 1.5rem;
  }
  .hub__line {
    grid-area: line;
    color: var(--color-text-secondary);
  }
  .hub__list svg {
    grid-area: go;
    color: var(--color-accent);
  }
  .hub__foot {
    margin-top: var(--space-10);
    font-size: 0.9rem;
    color: var(--color-text-tertiary);
    max-width: 52ch;
  }
</style>
