---
/**
 * Inundación Scenario Page - ES
 *
 * Context:
 * - Spain experiences regular flooding (gota fría/DANA)
 * - Valencia, Murcia, Andalucía particularly affected
 * - DANA October 2024 caused major damage
 * - Flash floods are increasing due to climate change
 */
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import TLDRBlock from '../../../../components/hub/TLDRBlock.astro';
import CollapsibleSection from '../../../../components/hub/CollapsibleSection.astro';
import PhaseTabs from '../../../../components/hub/PhaseTabs.tsx';
import InteractiveChecklist from '../../../../components/hub/InteractiveChecklist.tsx';
import StickyActionBar from '../../../../components/hub/StickyActionBar.tsx';
import Icon from '../../../../components/ui/Icon.astro';
import HeroImage from '../../../../components/content/HeroImage.astro';

const scenarioKey = 'inundacion';

// Warning levels
const warningLevels = [
  { level: 'Verde', description: 'Sin riesgo significativo', action: 'Situación normal', color: '#22c55e' },
  { level: 'Amarillo', description: 'Peligro bajo, con algunos impactos posibles', action: 'Sigue la predicción', color: '#eab308' },
  { level: 'Naranja', description: 'Peligro importante, con posibles impactos graves', action: 'Limita las actividades no esenciales', color: '#f97316' },
  { level: 'Rojo', description: 'Peligro extraordinario, con posibles impactos muy graves o catastróficos', action: 'Infórmate en tiempo real, sigue a las autoridades y evita desplazamientos no urgentes', color: '#ef4444' },
];

// Phase content
const phases = {
  antes: [
    {
      title: 'Conoce el riesgo de tu zona',
      detail: 'Comprueba si vives en zona inundable. Consulta el Sistema Nacional de Cartografía de Zonas Inundables del MITECO o pregunta en tu ayuntamiento.',
      tip: 'Las zonas cerca de ríos, barrancos o zonas bajas tienen mayor riesgo'
    },
    {
      title: 'Prepara un kit de evacuación',
      detail: 'Mochila con agua, comida, documentos, medicinas, linterna, cargador. Lista para coger en 5 minutos.',
      tip: 'Incluye ropa de recambio en bolsa impermeable'
    },
    {
      title: 'Planifica rutas de evacuación',
      detail: 'Conoce al menos 2 rutas para salir de tu zona hacia terreno alto. Practica con tu familia.',
      tip: 'Evita rutas que pasen por puentes bajos o zonas inundables'
    },
    {
      title: 'Asegura tu vivienda',
      detail: 'Revisa desagües y canalones. Guarda objetos de valor en zonas altas. Ten sacos de arena si es zona de riesgo.',
      tip: null
    },
    {
      title: 'Documenta tus pertenencias',
      detail: 'Fotos y vídeo de casa y pertenencias para el seguro. Guarda copias en la nube.',
      tip: null
    },
    {
      title: 'Mantén el coche preparado',
      detail: 'Depósito siempre a medio llenar. Kit de emergencia en el maletero.',
      tip: 'Aparca en zona alta si hay alerta'
    },
  ],
  durante: [
    {
      title: 'Sigue las alertas oficiales',
      detail: 'AEMET, Protección Civil, 112. No tienes que instalar ni activar nada: ES-Alert llega a todos los móviles con cobertura en la zona, aunque estén en silencio.',
      tip: 'No te fíes solo de apps meteorológicas comerciales'
    },
    {
      title: 'Evita zonas inundables',
      detail: 'No cruces zonas inundadas ni en coche ni a pie.',
      tip: null
    },
    {
      title: 'Si estás en casa',
      detail: 'Sube a plantas altas. Corta la luz si el agua sube. No bajes al sótano ni garaje.',
      tip: 'NUNCA intentes salvar el coche de un garaje inundado'
    },
    {
      title: 'Si estás en el coche',
      detail: 'Da la vuelta si ves agua en la carretera. Si el agua te atrapa, sal del coche inmediatamente.',
      tip: 'Sal del coche si se atasca, si el agua supera los ejes de las ruedas o te llega a la rodilla, o si el nivel empieza a subir'
    },
    {
      title: 'Si te atrapan las aguas',
      detail: 'Sube al punto más alto posible. Señala tu posición. Llama al 112.',
      tip: 'Aléjate de ríos, arroyos y zonas bajas y ve a un punto elevado'
    },
    {
      title: 'Evacúa si te lo ordenan',
      detail: 'No ignores las órdenes de evacuación. Coge tu kit y sigue las rutas indicadas.',
      tip: 'Corta agua, luz y gas antes de salir'
    },
  ],
  despues: [
    {
      title: 'Espera el aviso oficial',
      detail: 'No vuelvas a casa hasta que Protección Civil diga que es seguro.',
      tip: null
    },
    {
      title: 'Cuidado al entrar en casa',
      detail: 'Puede haber daños estructurales, animales peligrosos, cables eléctricos.',
      tip: 'Haz fotos de todo para el seguro antes de tocar nada'
    },
    {
      title: 'No bebas el agua del grifo',
      detail: 'Puede estar contaminada. Usa agua embotellada hasta que se confirme que es segura.',
      tip: null
    },
    {
      title: 'Desecha alimentos en contacto con agua',
      detail: 'Cualquier comida que haya tocado el agua de inundación no es segura.',
      tip: 'Las latas y tarros herméticos y sin daños se pueden aprovechar: lávalos con agua y jabón, sumérgelos dos minutos en agua hirviendo y déjalos secar antes de abrirlos'
    },
    {
      title: 'Limpia y desinfecta',
      detail: 'El barro de inundación puede contener bacterias y químicos. Usa lejía diluida.',
      tip: 'Usa mascarilla y guantes'
    },
    {
      title: 'Busca apoyo',
      detail: 'Contacta con tu seguro. Solicita ayudas oficiales si existen. Cuida tu salud mental.',
      tip: null
    },
  ],
};

// Checklist categories
const checklistCategories = [
  {
    id: 'kit-evacuacion',
    name: 'Kit de evacuación',
    icon: 'backpack',
    items: [
      { id: 'mochila', name: 'Mochila impermeable', quantity: '30-40L', priority: 'critical' as const },
      { id: 'agua', name: 'Agua potable', quantity: '1.5L/persona', priority: 'critical' as const, notes: 'Para las primeras horas' },
      { id: 'comida', name: 'Comida no perecedera', quantity: '24h/persona', priority: 'critical' as const, notes: 'Barritas, frutos secos' },
      { id: 'documentos', name: 'Copias de documentos', quantity: 'En bolsa impermeable', priority: 'critical' as const },
      { id: 'medicinas', name: 'Medicamentos esenciales', quantity: '1 semana', priority: 'critical' as const },
      { id: 'dinero', name: 'Efectivo', quantity: '70-100 €/persona', priority: 'critical' as const, notes: 'Billetes pequeños y monedas; referencia del Banco de España' },
    ]
  },
  {
    id: 'iluminacion',
    name: 'Iluminación y comunicación',
    icon: 'flashlight',
    items: [
      { id: 'linterna', name: 'Linterna LED impermeable', quantity: '1-2 unidades', priority: 'critical' as const },
      { id: 'pilas', name: 'Pilas de repuesto', quantity: '2 sets', priority: 'critical' as const },
      { id: 'powerbank', name: 'Powerbank cargada', quantity: '10.000mAh+', priority: 'critical' as const },
      { id: 'radio', name: 'Radio con pilas/dinamo', quantity: '1 unidad', priority: 'critical' as const },
      { id: 'silbato', name: 'Silbato', quantity: '1/persona', priority: 'recommended' as const, notes: 'Para pedir ayuda' },
    ]
  },
  {
    id: 'proteccion',
    name: 'Protección personal',
    icon: 'shield',
    items: [
      { id: 'ropa', name: 'Ropa de recambio', quantity: '1 muda', priority: 'critical' as const, notes: 'En bolsa impermeable' },
      { id: 'calzado', name: 'Calzado resistente al agua', quantity: '1 par', priority: 'recommended' as const },
      { id: 'chubasquero', name: 'Chubasquero/poncho', quantity: '1/persona', priority: 'critical' as const },
      { id: 'guantes', name: 'Guantes de trabajo', quantity: '1 par', priority: 'recommended' as const },
      { id: 'mascarilla', name: 'Mascarillas FFP2', quantity: '5-10', priority: 'recommended' as const, notes: 'Para limpieza posterior' },
    ]
  },
  {
    id: 'vehiculo',
    name: 'Preparación del vehículo',
    icon: 'car',
    items: [
      { id: 'deposito', name: 'Depósito mínimo medio lleno', quantity: 'Siempre', priority: 'critical' as const },
      { id: 'kit-coche', name: 'Kit emergencia en maletero', quantity: '1 kit', priority: 'recommended' as const },
      { id: 'martillo', name: 'Martillo rompe cristales', quantity: '1 unidad', priority: 'critical' as const, notes: 'Puede salvar tu vida' },
      { id: 'manta', name: 'Manta térmica', quantity: '1-2', priority: 'recommended' as const },
    ]
  },
  {
    id: 'hogar',
    name: 'Preparación del hogar',
    icon: 'home',
    items: [
      { id: 'desagues', name: 'Desagües y canalones limpios', quantity: 'Revisar', priority: 'critical' as const },
      { id: 'objetos-altos', name: 'Objetos de valor en zonas altas', quantity: 'Organizar', priority: 'recommended' as const },
      { id: 'fotos-seguro', name: 'Fotos/vídeo de pertenencias', quantity: 'Actualizado', priority: 'recommended' as const },
      { id: 'sacos', name: 'Sacos de arena (zona riesgo)', quantity: '10-20', priority: 'recommended' as const },
    ]
  },
];

// Recent flood events in Spain
const recentFloods = [
  { date: 'Oct 2024', event: 'DANA en Valencia', impact: 'Inundaciones catastróficas en la provincia de Valencia' },
  { date: 'Sep 2019', event: 'DANA en Alicante y Murcia', impact: '7 fallecidos entre el 11 y el 15 de septiembre, según AEMET' },
];

// FAQs
const faqs = [
  {
    question: '¿Qué es una DANA?',
    answer: 'Una DANA (Depresión Aislada en Niveles Altos) es una baja con aire frío en altura que se separa de la corriente en chorro. Puede provocar lluvias torrenciales, sobre todo en el Mediterráneo. «Gota fría» es el nombre popular.'
  },
  {
    question: '¿Cuánta agua puede arrastrar un coche?',
    answer: 'Protección Civil no da una cifra: pide no cruzar zonas inundadas ni en coche ni a pie. Sal del coche si se atasca, si el agua supera los ejes de las ruedas o te llega a la rodilla, o si el nivel empieza a subir. Si no puedes abrir las puertas, sal por las ventanillas.'
  },
  {
    question: '¿Debo bajar al garaje a por mi coche?',
    answer: 'NUNCA. Los garajes son trampas mortales durante inundaciones. El agua puede subir muy rápido y las puertas pueden bloquearse. Tu vida vale más que cualquier coche.'
  },
  {
    question: '¿Cuándo debo evacuar?',
    answer: 'Evacúa cuando lo indiquen las autoridades. Si el agua entra en casa, sal de sótanos y plantas bajas lo antes posible, corta la electricidad y usa una linterna. En la calle, aléjate de ríos, arroyos y zonas bajas y ve a un punto elevado.'
  },
  {
    question: '¿Cómo sé si mi zona es inundable?',
    answer: 'Consulta el Sistema Nacional de Cartografía de Zonas Inundables (SNCZI) del MITECO, o pregunta en tu ayuntamiento. Las zonas cerca de ríos, barrancos o depresiones tienen más riesgo.'
  },
  {
    question: '¿Puedo beber el agua del grifo después de una inundación?',
    answer: 'No hasta que las autoridades confirmen que es segura. La red de agua puede haberse contaminado. Usa solo agua embotellada.'
  },
];
---

<BaseLayout
  title="Inundación y DANA: Cómo actuar — Checklist Emergencia"
  description="Cómo prepararse antes, durante y después de una inundación o DANA. Checklist de evacuación, consejos de seguridad y qué hacer si el agua te atrapa."
  locale="es"
  schemaType="Article"
  dateModified="2026-11-18"
  alternates={{
    de: '/de/szenarien/hochwasser/',
    nl: '/nl/scenario/overstroming/',
  }}
  faqData={faqs}
>
  <article class="scenario-page">
    <!-- Header -->
    <header class="scenario-header">
      <nav class="scenario-breadcrumb">
        <a href="/es/escenarios/" class="breadcrumb-back">
          <Icon name="ChevronLeft" size={20} />
        </a>
        <span class="breadcrumb-current">Inundación</span>
      </nav>

      <div class="scenario-title-row">
        <div class="scenario-icon scenario-icon--blue">
          <Icon name="Waves" size={28} />
        </div>
        <div class="scenario-title-content">
          <h1 class="scenario-title">Prepararse para Inundaciones</h1>
          <div class="scenario-meta">
            <span class="meta-item">10 min</span>
            <span class="meta-divider">·</span>
            <span class="meta-item">Actualizado nov. 2026</span>
          </div>
        </div>
      </div>
    </header>

    <!-- Hero Image -->
    <section class="scenario-section">
      <HeroImage
        src="/images/shared/flood.webp"
        alt="Botas de agua amarillas sobre una lámina de agua junto a dos sacos de arena, una funda impermeable y una linterna"
        priority={true}
      />
    </section>

    <!-- TL;DR -->
    <section class="scenario-section">
      <TLDRBlock
        summary="Las inundaciones por DANA matan cada año en España. La preparación salva vidas: conoce si vives en zona de riesgo, ten un kit de evacuación listo, y no cruces zonas inundadas ni en coche ni a pie. Si el coche se atasca o el agua supera los ejes de las ruedas, sal de él."
        keyStat="Nunca"
        keyStatLabel="cruces una zona inundada"
        locale="es"
      />
    </section>

    <!-- Recent Floods -->
    <section class="scenario-section">
      <h2 class="section-title">
        <Icon name="History" size={24} />
        Inundaciones recientes en España
      </h2>
      <div class="examples-list">
        {recentFloods.map((flood) => (
          <div class="example-item">
            <div class="example-date">{flood.date}</div>
            <div class="example-content">
              <span class="example-event">{flood.event}</span>
              <span class="example-impact">{flood.impact}</span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Warning Levels -->
    <section class="scenario-section">
      <h2 class="section-title">
        <Icon name="AlertTriangle" size={24} />
        Niveles de aviso de AEMET
      </h2>
      <div class="warning-levels">
        {warningLevels.map((level) => (
          <div class="warning-level" style={`border-left-color: ${level.color}`}>
            <div class="warning-level-header">
              <span class="warning-level-name" style={`color: ${level.color}`}>{level.level}</span>
              <span class="warning-level-desc">{level.description}</span>
            </div>
            <div class="warning-level-action">{level.action}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- Critical Warning -->
    <section class="scenario-section">
      <div class="critical-warning">
        <div class="critical-warning-icon">
          <Icon name="AlertOctagon" size={32} />
        </div>
        <div class="critical-warning-content">
          <h3>Regla de oro: NUNCA cruces agua en movimiento</h3>
          <ul>
            <li>No cruces zonas inundadas, ni en coche ni a pie</li>
            <li>Sal del coche si se atasca o si el agua supera los <strong>ejes de las ruedas</strong></li>
            <li>Si no puedes abrir las puertas, sal por las <strong>ventanillas</strong></li>
          </ul>
          <p>Si el agua sube, sube tú. NUNCA bajes a sótanos o garajes.</p>
        </div>
      </div>
    </section>

    <!-- Phase Tabs -->
    <PhaseTabs
      client:idle
      scenarioKey={scenarioKey}
      locale="es"
    />

    <!-- Phase: Antes -->
    <section id="antes" class="phase-section">
      <div class="phase-header">
        <span class="phase-number">1</span>
        <div class="phase-title-group">
          <h2 class="phase-title">Antes de la inundación</h2>
          <p class="phase-subtitle">Preparación preventiva</p>
        </div>
      </div>

      <div class="phase-steps">
        {phases.antes.map((step, index) => (
          <CollapsibleSection
            title={step.title}
            summary={step.detail}
            step={index + 1}
            variant="card"
          >
            <p>{step.detail}</p>
            {step.tip && (
              <div class="step-tip">
                <Icon name="Lightbulb" size={16} />
                <span>{step.tip}</span>
              </div>
            )}
          </CollapsibleSection>
        ))}
      </div>
    </section>

    <!-- Phase: Durante -->
    <section id="durante" class="phase-section">
      <div class="phase-header">
        <span class="phase-number phase-number--warning">2</span>
        <div class="phase-title-group">
          <h2 class="phase-title">Durante la inundación</h2>
          <p class="phase-subtitle">Supervivencia activa</p>
        </div>
      </div>

      <!-- Warning Box -->
      <div class="warning-box">
        <div class="warning-icon">
          <Icon name="AlertTriangle" size={24} />
        </div>
        <div class="warning-content">
          <strong>Errores mortales a evitar</strong>
          <ul>
            <li>Cruzar agua en movimiento (a pie o en coche)</li>
            <li>Bajar al garaje o sótano</li>
            <li>Quedarse en coche atrapado</li>
            <li>Ignorar órdenes de evacuación</li>
          </ul>
        </div>
      </div>

      <div class="phase-steps">
        {phases.durante.map((step, index) => (
          <CollapsibleSection
            title={step.title}
            summary={step.detail}
            step={index + 1}
            variant="card"
          >
            <p>{step.detail}</p>
            {step.tip && (
              <div class="step-tip">
                <Icon name="Lightbulb" size={16} />
                <span>{step.tip}</span>
              </div>
            )}
          </CollapsibleSection>
        ))}
      </div>
    </section>

    <!-- Phase: Después -->
    <section id="despues" class="phase-section">
      <div class="phase-header">
        <span class="phase-number phase-number--success">3</span>
        <div class="phase-title-group">
          <h2 class="phase-title">Después de la inundación</h2>
          <p class="phase-subtitle">Regreso y recuperación</p>
        </div>
      </div>

      <div class="phase-steps">
        {phases.despues.map((step, index) => (
          <CollapsibleSection
            title={step.title}
            summary={step.detail}
            step={index + 1}
            variant="card"
          >
            <p>{step.detail}</p>
            {step.tip && (
              <div class="step-tip">
                <Icon name="Lightbulb" size={16} />
                <span>{step.tip}</span>
              </div>
            )}
          </CollapsibleSection>
        ))}
      </div>
    </section>

    <!-- Interactive Checklist -->
    <section class="scenario-section">
      <h2 class="section-title">
        <Icon name="CheckSquare" size={24} />
        Tu checklist de inundación
      </h2>
      <p class="section-intro">
        Marca lo que ya tienes preparado. Tu progreso se guarda automáticamente.
      </p>
      <InteractiveChecklist
        client:idle
        storageKey={`${scenarioKey}_es`}
        categories={checklistCategories}
        title="Preparado para inundaciones"
      />
    </section>

    <!-- FAQs -->
    <section class="scenario-section">
      <h2 class="section-title">Preguntas frecuentes</h2>
      <div class="faq-list">
        {faqs.map((faq) => (
          <details class="faq-item">
            <summary class="faq-question">
              <span>{faq.question}</span>
              <Icon name="ChevronDown" size={20} />
            </summary>
            <div class="faq-answer">
              <p>{faq.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- Sources -->
    <section class="scenario-section">
      <details class="sources-block">
        <summary class="sources-header">
          <Icon name="BookOpen" size={18} />
          <span>Fuentes y referencias</span>
          <Icon name="ChevronDown" size={16} />
        </summary>
        <div class="sources-content">
          <ul>
            <li><a href="https://www.aemet.es/es/eltiempo/prediccion/avisos/ayuda" target="_blank" rel="noopener">AEMET - Qué significan los avisos</a></li>
            <li><a href="https://www.proteccioncivil.es/coordinacion/gestion-de-riesgos/hidrologicos/inundaciones" target="_blank" rel="noopener">Protección Civil - Inundaciones: consejos de autoprotección</a></li>
            <li><a href="https://www.proteccioncivil.es/coordinacion/redes/ran/public-warning-system" target="_blank" rel="noopener">Protección Civil - ES-Alert</a></li>
            <li><a href="https://www.miteco.gob.es/es/agua/temas/gestion-de-los-riesgos-de-inundacion/" target="_blank" rel="noopener">MITECO - Gestión de Riesgos de Inundación</a></li>
            <li><a href="https://www.miteco.gob.es/es/agua/temas/gestion-de-los-riesgos-de-inundacion/snczi.html" target="_blank" rel="noopener">SNCZI - Sistema Nacional de Cartografía de Zonas Inundables</a></li>
          </ul>
        </div>
      </details>
    </section>

    <!-- Related Scenarios -->
    <section class="scenario-section">
      <h2 class="section-title">Escenarios relacionados</h2>
      <div class="related-grid">
        <a href="/es/escenarios/prepararse-apagon/" class="related-card related-card--amber">
          <Icon name="Zap" size={24} />
          <span>Apagón</span>
        </a>
        <a href="/es/escenarios/kit-evacuacion/" class="related-card related-card--emerald">
          <Icon name="Backpack" size={24} />
          <span>Kit de Evacuación</span>
        </a>
      </div>
    </section>
  </article>

  <!-- Sticky Action Bar -->
  <StickyActionBar
    client:idle
    actionText="Prepara tu kit de evacuación"
    actionUrl="/es/escenarios/kit-evacuacion/"
    dismissKey={`scenario_${scenarioKey}_es`}
    label="Próximo paso:"
    locale="es"
  />
</BaseLayout>

<style>
  .scenario-page {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 16px 120px;
  }

  .scenario-header {
    padding: 16px 0 24px;
  }

  .scenario-breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
  }

  .breadcrumb-back {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: var(--color-bg-secondary);
    border-radius: 10px;
    color: var(--color-text-secondary);
    transition: all 0.15s ease;
  }

  .breadcrumb-back:hover {
    background: var(--color-bg-tertiary);
    color: var(--color-text-primary);
  }

  .breadcrumb-current {
    font-size: 14px;
    color: var(--color-text-muted);
  }

  .scenario-title-row {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  .scenario-icon {
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 16px;
  }

  .scenario-icon--blue {
    background: rgba(59, 130, 246, 0.15);
    color: #3b82f6;
  }

  .scenario-title-content {
    flex: 1;
    min-width: 0;
  }

  .scenario-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text-primary);
