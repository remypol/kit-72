---
/**
 * Apagón España 2025 - Event-Specific Page
 *
 * Topical content about the massive blackout that affected Spain and Portugal
 * on April 28, 2025. High search interest, provides context and lessons learned.
 */
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../../components/layout/Breadcrumb.astro';
import Icon from '../../../../components/ui/Icon.astro';
import HeroImage from '../../../../components/content/HeroImage.astro';

// Times from the Government's Comité de Análisis report (17 June 2025), read on 2026-11-18.
const timeline = [
  { time: '12:03', event: 'Primera oscilación relevante en el sistema eléctrico', severity: 'warning' },
  { time: '12:19', event: 'Segunda oscilación', severity: 'warning' },
  { time: '12:32', event: 'La tensión sube y empiezan a desconectarse centrales de generación', severity: 'critical' },
  { time: '12:33:30', event: 'Cero de tensión en la península', severity: 'critical' },
  { time: '12:44', event: 'Llega tensión desde Francia a la subestación de Hernani', severity: 'info' },
  { time: '13:07', event: 'Se alimenta la primera carga del sistema español', severity: 'info' },
  { time: '22:30', event: 'Cerca del 50 % de la demanda ha recuperado el suministro', severity: 'info' },
  { time: '07:00', event: '29 de abril: el 99,95 % del suministro está restablecido', severity: 'info' },
];

const impacts = [
  { sector: 'Transporte', description: 'Sin electricidad se paran metros y trenes y se apagan los semáforos.', icon: 'Train' },
  { sector: 'Comunicaciones', description: 'Las redes móviles se saturan y la batería del móvil dura menos buscando señal.', icon: 'Wifi' },
  { sector: 'Pagos', description: 'Los pagos electrónicos dejaron de funcionar y hubo cajeros sin billetes o fuera de servicio, según el Banco de España.', icon: 'ShoppingCart' },
  { sector: 'Sanidad', description: 'Los hospitales cuentan con generadores de emergencia; consultas y centros de salud pueden cerrar.', icon: 'Heart' },
  { sector: 'Hogares', description: 'Ascensores parados, frigoríficos sin frío y calefacción o aire acondicionado apagados.', icon: 'Home' },
];

const lessons = [
  {
    title: 'El efectivo sigue siendo rey',
    description: 'Sin electricidad, no hay datáfonos, cajeros ni Bizum. Quienes tenían efectivo pudieron comprar.',
    action: 'Ten algo de efectivo en casa en billetes pequeños; como referencia, 70-100 € por persona'
  },
  {
    title: 'Las baterías de los móviles no duran',
    description: 'Con las redes saturadas, los móviles gastaban batería buscando señal constantemente.',
    action: 'Ten siempre una powerbank cargada (20.000+ mAh)'
  },
  {
    title: 'La información es poder',
    description: 'Sin internet ni TV, muchos no sabían qué pasaba. La radio fue clave.',
    action: 'Ten una radio con pilas o dinamo en casa'
  },
  {
    title: 'Comprar se complica',
    description: 'Sin datáfonos, muchas tiendas solo pueden cobrar en efectivo.',
    action: 'Mantén siempre comida para 72h en casa'
  },
  {
    title: 'El agua puede fallar también',
    description: 'Las bombas de agua necesitan electricidad. En edificios altos puede faltar presión.',
    action: 'Guarda agua: en Kit-72 calculamos 9 litros por persona para 3 días'
  },
];

const faqs = [
  {
    question: '¿Qué causó el apagón de abril de 2025?',
    answer: 'El Comité de Análisis del Gobierno concluyó en junio de 2025 que el apagón tuvo un origen multifactorial: una sobretensión provocó desconexiones de generación en cadena, en un sistema con poca capacidad para controlar la tensión. No halló indicios de ciberataque. El informe final del panel europeo de ENTSO-E se publicó en marzo de 2026.'
  },
  {
    question: '¿A quién afectó?',
    answer: 'España peninsular y Portugal se quedaron sin suministro eléctrico.'
  },
  {
    question: '¿Puede volver a pasar?',
    answer: 'Sí. La red eléctrica es compleja y un fallo técnico, un fenómeno meteorológico extremo o un problema de generación pueden causar otro corte. Por eso conviene estar preparado.'
  },
  {
    question: '¿Cuánto duró el apagón?',
    answer: 'El apagón empezó a las 12:33. A las 22:30 había recuperado el suministro cerca de la mitad de la demanda y a las 7:00 del 29 de abril, el 99,95 %. Fueron más de 18 horas.'
  },
  {
    question: '¿Quién fue responsable?',
    answer: 'Los informes no coinciden en el reparto de responsabilidades. El Comité del Gobierno señala que había menos centrales con control de tensión de las programadas. Red Eléctrica sostiene que el informe europeo no le atribuye la causa.'
  },
];
---

<BaseLayout
  title="Apagón de España del 28 de abril de 2025: qué pasó"
  description="El apagón empezó a las 12:33 y el 99,95 % del suministro no volvió hasta las 7:00 del día siguiente. Cronología, causas según el informe oficial y lecciones."
  locale="es"
  dateModified="2026-11-18"
  schemaType="Article"
  schemaData={{
    headline: 'Apagón España Abril 2025: Análisis y Lecciones',
    datePublished: '2025-04-28',
    dateModified: '2026-11-18',
  }}
  faqData={faqs}
>
  <section class="py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <Breadcrumb
        items={[
          { label: 'Escenarios', href: '/es/escenarios/' },
          { label: 'Apagón España 2025' }
        ]}
        class="mb-4"
        locale="es"
      />

      <header class="mb-8">
        <div class="flex items-center gap-2 text-sm text-(--color-text-muted) mb-2">
          <Icon name="Calendar" size={16} />
          <span>28 de abril de 2025</span>
          <span class="mx-2">•</span>
          <span>12 min de lectura</span>
        </div>
        <h1 class="text-4xl font-bold mb-4">
          Apagón España 2025: Qué Pasó y Cómo Prepararse
        </h1>
        <p class="text-xl text-(--color-text-secondary)">
          El 28 de abril de 2025, España y Portugal sufrieron el mayor apagón de su historia.
          Esto es lo que ocurrió, según el informe del Gobierno, y lo que conviene aprender.
        </p>
      </header>

      <HeroImage
        src="/images/shared/power-outage.webp"
        alt="Vela encendida, cerillas, una linterna encendida, una radio y un termo"
        priority={true}
      />

      <div class="prose prose-lg mt-8">

        <!-- Key Stats -->
        <div class="not-prose grid sm:grid-cols-3 gap-4 my-8">
          <div class="card p-4 text-center">
            <p class="text-3xl font-bold text-(--color-accent-primary)">12:33</p>
            <p class="text-sm text-(--color-text-secondary)">Hora del cero de tensión</p>
          </div>
          <div class="card p-4 text-center">
            <p class="text-3xl font-bold text-(--color-accent-primary)">+18 h</p>
            <p class="text-sm text-(--color-text-secondary)">Hasta recuperar el 99,95 %</p>
          </div>
          <div class="card p-4 text-center">
            <p class="text-3xl font-bold text-(--color-accent-primary)">2</p>
            <p class="text-sm text-(--color-text-secondary)">Países afectados</p>
          </div>
        </div>

        <h2>Cronología del Apagón</h2>
        <p>
          Tras dos oscilaciones a mediodía, el sistema colapsó en poco más de un minuto: a las 12:33:30 la península
          quedó a cero de tensión. Las horas son las del informe del Comité de Análisis del Gobierno.
        </p>

        <div class="not-prose my-8">
          <div class="space-y-3">
            {timeline.map((item) => (
              <div class={`flex items-start gap-4 p-4 rounded-lg border-l-4 ${
                item.severity === 'critical' ? 'border-l-red-500 bg-red-50 dark:bg-red-950/20' :
                item.severity === 'high' ? 'border-l-amber-500 bg-amber-50 dark:bg-amber-950/20' :
                item.severity === 'warning' ? 'border-l-yellow-500 bg-yellow-50 dark:bg-yellow-950/20' :
                'border-l-green-500 bg-green-50 dark:bg-green-950/20'
              }`}>
                <span class="font-mono font-bold text-lg min-w-[60px]">{item.time}</span>
                <span class="text-(--color-text-primary)">{item.event}</span>
              </div>
            ))}
          </div>
        </div>

        <h2>Impacto por Sectores</h2>
        <p>
          El apagón no solo apagó las luces. Paralizó la vida moderna tal como la conocemos.
        </p>

        <div class="not-prose grid sm:grid-cols-2 gap-4 my-8">
          {impacts.map((impact) => (
            <div class="card p-4">
              <div class="flex items-center gap-3 mb-2">
                <div class="w-10 h-10 rounded-full bg-(--color-accent-subtle) flex items-center justify-center">
                  <Icon name={impact.icon} size={20} class="text-(--color-accent-primary)" />
                </div>
                <h3 class="font-semibold">{impact.sector}</h3>
              </div>
              <p class="text-sm text-(--color-text-secondary)">{impact.description}</p>
            </div>
          ))}
        </div>

        <h2>5 Lecciones que Debemos Aprender</h2>
        <p>
          Este apagón fue un simulacro involuntario. Nos mostró exactamente qué falla
          cuando desaparece la electricidad. Estas son las lecciones clave:
        </p>

        <div class="not-prose space-y-6 my-8">
          {lessons.map((lesson, index) => (
            <div class="card p-6">
              <div class="flex items-start gap-4">
                <span class="flex-shrink-0 w-8 h-8 rounded-full bg-(--color-accent-primary) text-(--color-bg-primary) flex items-center justify-center font-bold">
                  {index + 1}
                </span>
                <div>
                  <h3 class="font-semibold text-lg mb-2">{lesson.title}</h3>
                  <p class="text-(--color-text-secondary) mb-3">{lesson.description}</p>
                  <div class="flex items-center gap-2 text-sm font-medium text-(--color-accent-primary)">
                    <Icon name="ArrowRight" size={16} />
                    <span>{lesson.action}</span>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

        <p class="text-sm">
          Fuentes: <a href="https://www.lamoncloa.gob.es/consejodeministros/resumenes/Documents/2025/Informe-no-confidencial-Comite-de-analisis-28A.pdf" target="_blank" rel="noopener">informe del Comité de Análisis del Gobierno</a> (17 de junio de 2025),
          <a href="https://www.lamoncloa.gob.es/consejodeministros/resumenes/paginas/2025/170625-rueda-de-prensa-ministros.aspx" target="_blank" rel="noopener">La Moncloa</a>,
          <a href="https://www.entsoe.eu/publications/blackout/28-april-2025-iberian-blackout/" target="_blank" rel="noopener">panel de expertos de ENTSO-E</a> y
          <a href="https://www.bde.es/wbe/es/noticias-eventos/blog/como-pagamos-cuando-todo-se-apaga-la-experiencia-del-apagon-en-espana.html" target="_blank" rel="noopener">Banco de España</a>. Consultadas el 18 de noviembre de 2026.
        </p>

        <h2>¿Estás Preparado para el Próximo?</h2>
        <p>
          En 2025, la mayor parte del suministro tardó entre diez y dieciocho horas en volver. La próxima vez podría ser
          más largo. Un ciberataque, un fenómeno meteorológico extremo o un fallo
          en cascada podrían causar cortes de días.
        </p>
        <p>
          <strong>La buena noticia:</strong> prepararse es sencillo y económico.
          Con los elementos básicos puedes estar listo para cualquier corte.
        </p>

        <!-- CTA Box -->
        <div class="not-prose card p-6 my-8 bg-(--color-accent-subtle) border-2 border-(--color-accent-primary)">
          <h3 class="font-semibold text-xl mb-3">Prepárate en 3 pasos</h3>
          <ol class="space-y-2 mb-4">
            <li class="flex items-center gap-2">
              <span class="w-6 h-6 rounded-full bg-(--color-accent-primary) text-(--color-bg-primary) flex items-center justify-center text-sm font-bold">1</span>
              <span>Lee nuestra <a href="/es/escenarios/prepararse-apagon/" class="text-(--color-accent-primary) hover:underline font-medium">guía completa de apagones</a></span>
            </li>
            <li class="flex items-center gap-2">
              <span class="w-6 h-6 rounded-full bg-(--color-accent-primary) text-(--color-bg-primary) flex items-center justify-center text-sm font-bold">2</span>
              <span>Usa nuestro <a href="/es/herramientas/configurador-kit/" class="text-(--color-accent-primary) hover:underline font-medium">configurador de kit</a> personalizado</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="w-6 h-6 rounded-full bg-(--color-accent-primary) text-(--color-bg-primary) flex items-center justify-center text-sm font-bold">3</span>
              <span>Revisa los <a href="/es/componentes/" class="text-(--color-accent-primary) hover:underline font-medium">componentes esenciales</a></span>
            </li>
          </ol>
        </div>

        <h2>Preguntas Frecuentes</h2>

        <div class="not-prose space-y-4 my-8">
          {faqs.map((faq) => (
            <details class="card p-4 group">
              <summary class="font-semibold cursor-pointer list-none flex items-center justify-between">
                {faq.question}
                <Icon name="ChevronDown" size={20} class="transform group-open:rotate-180 transition-transform" />
              </summary>
              <p class="mt-3 text-(--color-text-secondary)">{faq.answer}</p>
            </details>
          ))}
        </div>

        <h2>Conclusión</h2>
        <p>
          El apagón de abril de 2025 fue un recordatorio brutal de lo dependientes que somos
          de la electricidad. Pero también fue una oportunidad para aprender.
        </p>
        <p>
          No podemos evitar que ocurran apagones. Pero sí podemos estar preparados.
          Y la preparación empieza hoy, no cuando ya es tarde.
        </p>

      </div>

      <!-- Related Links -->
      <div class="mt-12 grid sm:grid-cols-2 gap-4">
        <a href="/es/escenarios/prepararse-apagon/" class="card p-6 hover:border-(--color-accent-primary) transition-colors group">
          <h3 class="font-semibold mb-2 group-hover:text-(--color-accent-primary)">
            Guía: Prepararse para un Apagón
          </h3>
          <p class="text-sm text-(--color-text-secondary)">
            Pasos detallados antes, durante y después de un corte de luz.
          </p>
        </a>
        <a href="/es/componentes/powerbanks/" class="card p-6 hover:border-(--color-accent-primary) transition-colors group">
          <h3 class="font-semibold mb-2 group-hover:text-(--color-accent-primary)">
            Powerbanks para Emergencias
          </h3>
          <p class="text-sm text-(--color-text-secondary)">
            Cómo elegir la batería externa adecuada para tu kit.
          </p>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
