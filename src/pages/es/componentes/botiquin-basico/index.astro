    { item: 'Venda de gasa', qty: '2', notes: 'Para sujetar apósitos', priority: 'essential' },
    { item: 'Esparadrapo', qty: '1-2', notes: 'Hipoalergénico', priority: 'essential' },
    { item: 'Apósitos adhesivos grandes', qty: '5', notes: 'Para heridas mayores', priority: 'recommended' },
    { item: 'Venda triangular', qty: '1-2', notes: 'Cabestrillo, torniquete', priority: 'recommended' }
  ],
  antisepticos: [
