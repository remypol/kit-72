];

const maintenanceSchedule = [
  { task: 'Revisar caducidades', freq: 'Cada 3 meses', notes: 'Anotar próximas a caducar' },
  { task: 'Reponer consumidos', freq: 'Inmediatamente', notes: 'Después de cada uso' },
  { task: 'Verificar medicamentos', freq: 'Cada 6 meses', notes: 'Especialmente líquidos' },
  { task: 'Revisar estado general', freq: 'Cada 6 meses', notes: 'Humedad, daños, organización' },
  { task: 'Actualizar teléfonos', freq: 'Anual', notes: 'Emergencias, médicos, contactos' },
  { task: 'Renovar manta térmica', freq: 'Cada 3-5 años', notes: 'Se degrada con el tiempo' }
];

const kitSuggestion = [
  { item: 'Tiritas surtidas', qty: 20, notes: 'Varios tamaños' },
  { item: 'Gasas estériles 10x10', qty: 10, notes: 'En sobres individuales' },
