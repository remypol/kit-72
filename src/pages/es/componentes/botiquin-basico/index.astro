            <p class="text-2xl font-bold text-red-400">112</p>
            <p class="text-xs text-(--color-text-muted)">Emergencias</p>
          </div>
          <div>
            <p class="text-2xl font-bold text-red-400">061</p>
            <p class="text-xs text-(--color-text-muted)">Urgencias sanitarias</p>
          </div>
          <div>
            <p class="text-2xl font-bold text-red-400">091</p>
            <p class="text-xs text-(--color-text-muted)">Policía Nacional</p>
          </div>
          <div>
            <p class="text-2xl font-bold text-red-400">080</p>
            <p class="text-xs text-(--color-text-muted)">Bomberos</p>
          </div>
        </div>
      </div>

      <!-- Related Links -->
      <div class="flex flex-wrap gap-4 justify-center">
        <a
          href="/es/guias/botiquin-primeros-auxilios/"
          class="inline-flex items-center gap-2 px-4 py-2 border border-(--color-border) text-sm font-medium rounded hover:border-(--color-accent-primary) hover:text-(--color-accent-primary) transition-colors"
