  { name: 'Colirio lágrimas artificiales', use: 'Ojos secos/irritados', qty: '1 bote', notes: 'O monodosis' },
  { name: 'Protector labial SPF', use: 'Labios agrietados', qty: '1', notes: 'Con protección solar' }
];

const specialAdditions = [
  {
    group: 'Bebés y niños pequeños',
    items: ['Paracetamol infantil (jarabe)', 'Termómetro rectal', 'Suero oral pediátrico', 'Crema pañal', 'Aspirador nasal', 'Tiritas infantiles']
  },
  {
    group: 'Personas mayores',
    items: ['Medicación crónica extra (7 días)', 'Tensiómetro', 'Glucómetro si diabético', 'Lista de medicamentos y dosis', 'Lupa para leer prospectos']
  },
  {
    group: 'Alergias severas',
    items: ['Autoinyector adrenalina (EpiPen)', 'Antihistamínico inyectable', 'Corticoides orales', 'Tarjeta de alergia visible', 'Pulsera médica']
  },
  {
    group: 'Diabéticos',
    items: ['Glucómetro + tiras', 'Insulina si necesaria + nevera', 'Glucosa rápida (sobres/pastillas)', 'Snacks para hipoglucemia', 'Tarjeta diabético']
  },
  {
    group: 'Actividades outdoor',
    items: ['Vendaje israelí', 'Torniquete', 'Férula moldeable (SAM)', 'Pinzas garrapatas', 'Repelente insectos', 'Protector solar alto']
