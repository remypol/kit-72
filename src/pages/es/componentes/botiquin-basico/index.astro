    { item: 'Guantes nitrilo', qty: '4-6 pares', notes: 'Desechables', priority: 'essential' },
    { item: 'Termómetro digital', qty: '1', notes: 'Con pilas de repuesto', priority: 'essential' },
    { item: 'Manta térmica', qty: '1-2', notes: 'Emergencia, compacta', priority: 'essential' },
    { item: 'Linterna pequeña', qty: '1', notes: 'Para examinar', priority: 'recommended' },
    { item: 'Imperdibles', qty: '5-10', notes: 'Sujetar vendajes', priority: 'recommended' }
  ],
