---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { routes } from '../../../data/site';
const r = routes.es;
---

<BaseLayout title="Ya estás en la lista" locale="es" noIndex>
  <section class="thanks">
    <div data-state="ok">
      <h1>Tu dirección está confirmada</h1>
      <p>Tu lista va camino de tu bandeja de entrada. En las próximas dos semanas llegarán tres consejos breves, y dentro de seis meses un recordatorio para revisar agua, comida y pilas.</p>
      <a href={r.builder} class="btn btn-primary btn-lg">Seguir con mi lista</a>
    </div>
    <div data-state="error" hidden>
      <h1>Algo ha fallado al confirmar</h1>
      <p>No hemos guardado tu dirección. Vuelve a pedir tu lista; es medio minuto.</p>
      <a href={r.home} class="btn btn-primary btn-lg">Pedirla de nuevo</a>
    </div>
  </section>
</BaseLayout>

<script>
  if (new URLSearchParams(location.search).get('status') === 'error') {
    document.querySelector<HTMLElement>('[data-state="ok"]')!.hidden = true;
    document.querySelector<HTMLElement>('[data-state="error"]')!.hidden = false;
  }
</script>

<style>
  .thanks {
    max-width: 40rem;
    margin-inline: auto;
    padding: var(--space-16) var(--space-4) var(--space-24);
  }
  .thanks h1 {
    font-size: clamp(2rem, 4.4vw, 2.8rem);
  }
  .thanks p {
    margin-block: var(--space-4) var(--space-6);
    font-size: 1.15rem;
    color: var(--color-text-secondary);
  }
</style>
