---
/**
 * "Verder op Kit-72": a short list of pages that answer the next question a
 * reader of this page has. Each link has one line saying what is behind it.
 */
interface Props {
  title?: string;
  links: { href: string; label: string; note: string }[];
}
const { title = 'Verder op Kit-72', links } = Astro.props;
---

<section class="rel" aria-labelledby="rel-title">
  <h2 id="rel-title">{title}</h2>
  <ul>
    {links.map((l) => (
      <li>
        <a href={l.href}>{l.label}</a>
        <span>{l.note}</span>
      </li>
    ))}
  </ul>
</section>

<style>
  .rel {
    margin-block: var(--space-10);
    border-top: 3px solid var(--color-text-primary);
    padding-top: var(--space-4);
  }
  .rel h2 {
    font-size: 1.25rem;
    margin: 0 0 var(--space-3);
  }
  .rel ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0 var(--space-8);
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  }
  .rel li {
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-border);
    display: grid;
    gap: 2px;
  }
  .rel a {
    color: var(--color-accent);
    font-weight: 650;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .rel span {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
  }
  @media print {
    .rel {
      display: none;
    }
  }
</style>
