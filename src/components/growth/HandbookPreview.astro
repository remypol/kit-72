---
/**
 * Shows page 1 of the handbook for three very different addresses, so a
 * visitor sees that the outcome depends on the address and the household.
 * Images and figures come from handbook/scripts/samples.mjs.
 */
import data from '../../data/handbook-samples.json';

interface Props {
  /** id of the element the button jumps to (the request form) */
  formId: string;
}
const { formId } = Astro.props;
const { samples } = data;

/** Stickers on the paper: where on page 1 each fact sits, in percent of the page. */
const spots = [
  { left: 0, top: 27.5 },
  { left: 100, top: 19 },
  { left: 0, top: 55.5 },
  { left: 100, top: 46 },
  { left: 31, top: 77.8 },
];

const facts = (s: (typeof samples)[number]) => [
  { k: 'Voorraad voor 72 uur', v: `${s.water} liter water`, s: `voor ${s.household}, plus € ${s.cash} contant` },
  { k: 'Hoogte van het perceel', v: s.level, s: s.flood ? 'in overstromingsrisicogebied' : 'buiten overstromingsrisicogebied' },
  { k: 'Kaart van de buurt', v: s.shop ? `${s.shop.name} op ${s.shop.metres} m` : 'Je straat en omgeving', s: 'en de apotheek, AED, drinkwaterpunt en huisarts' },
  {
    k: 'Snelste spoedeisende hulp',
    v: `${s.hospital.minutes} min met de auto`,
    s: `naar ${s.hospital.name}${s.hospital.allDay ? ', dag en nacht open' : s.hospitalNight ? `; ’s nachts ${s.hospitalNight.minutes} min naar ${s.hospitalNight.name}` : ''}`,
  },
  { k: 'Rampenzender', v: s.broadcaster, s: `${s.dab ? `DAB+ blok ${s.dab}; ` : ''}FM-frequenties op pagina 4` },
];
---

<section class="hp" id="voorbeeld" data-handbook-preview aria-labelledby="hp-title">
  <div class="hp__inner">
    <header class="hp__head">
      <h2 id="hp-title">Drie adressen, drie verschillende handboeken</h2>
      <p>Dit is pagina 1 voor drie gemeentehuizen. Kies er een en kijk wat er verandert. Voor jouw adres en jouw huishouden komt er weer iets anders uit.</p>
    </header>

    <div class="hp__tabs" role="tablist" aria-label="Voorbeeldadres">
      {samples.map((s, i) => (
        <button class="hp__tab" type="button" role="tab" id={`hp-tab-${s.id}`} aria-controls={`hp-panel-${s.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-image={s.image}>
          <strong>{s.place}</strong>
          <span class="hp__tab-wide">{s.street}, {s.what.split(' ')[0].toLowerCase()}</span>
          <span class="hp__tab-narrow">{s.what.split(' ')[0]}</span>
        </button>
      ))}
    </div>

    {samples.map((s, i) => (
      <div class="hp__panel" role="tabpanel" id={`hp-panel-${s.id}`} aria-labelledby={`hp-tab-${s.id}`} hidden={i !== 0}>
        <figure class="hp__paper">
          <img src={s.image} alt={`Pagina 1 van het noodhandboek voor ${s.street} in ${s.place}`} width="1000" height="1416" loading="lazy" decoding="async" />
          {spots.map((spot, n) => (
            <span class="hp__sticker" style={`left:${spot.left}%;top:${spot.top}%`} aria-hidden="true">{n + 1}</span>
          ))}
        </figure>
        <div class="hp__side">
          <ol class="hp__facts">
            {facts(s).map((f, n) => (
              <li>
                <span class="hp__sticker hp__sticker--inline" aria-hidden="true">{n + 1}</span>
                <p class="hp__k">{f.k}</p>
                <p class="hp__v">{f.v}</p>
                <p class="hp__s">{f.s}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>
    ))}

    <div class="hp__foot">
      <p>Daarna volgen drie pagina's: wat je het eerste uur doet, ruim twintig slimme trucs en een noodplan dat je met pen invult.</p>
      <a class="btn btn-lg hp__button" href={`#${formId}`} data-focus-form>Maak het voor mijn adres</a>
    </div>
  </div>
</section>

<style>
  .hp {
    background: var(--color-deep);
    color: #fff;
    overflow: hidden;
  }
  .hp__inner {
    max-width: 72rem;
    margin-inline: auto;
    padding: var(--space-12) var(--space-4);
  }
  @media (min-width: 920px) {
    .hp__inner {
      padding-block: var(--space-16);
    }
  }
  .hp__head {
    max-width: 44rem;
    margin-bottom: var(--space-6);
  }
  .hp__head h2 {
    color: #fff;
    font-size: clamp(1.6rem, 3.4vw, 2.4rem);
    line-height: 1.08;
    margin-bottom: var(--space-3);
  }
  .hp__head p {
    color: #cfe3d7;
    font-size: 1.08rem;
  }

  .hp__tabs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-2);
    max-width: 44rem;
    margin-bottom: var(--space-8);
  }
  .hp__tab {
    display: grid;
    gap: 2px;
    text-align: left;
    padding: var(--space-3);
    min-height: 56px;
    color: #fff;
    background: transparent;
    border: 1.5px solid rgba(255, 255, 255, 0.35);
    border-radius: var(--radius-md);
    font: inherit;
    line-height: 1.2;
    cursor: pointer;
  }
  .hp__tab strong {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
  }
  .hp__tab-wide {
    display: none;
  }
  @media (min-width: 640px) {
    .hp__tab-wide {
      display: block;
    }
    .hp__tab-narrow {
      display: none;
    }
  }
  .hp__tab span {
    font-size: 0.82rem;
    color: #b9d2c4;
  }
  .hp__tab:hover {
    border-color: #fff;
  }
  .hp__tab[aria-selected='true'] {
    background: var(--color-signal);
    border-color: var(--color-signal);
    color: var(--color-signal-ink);
  }
  .hp__tab[aria-selected='true'] span {
    color: #4a4100;
  }
  .hp__tab:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 2px;
  }

  .hp__panel {
    display: grid;
    gap: var(--space-8);
  }
  .hp__panel[hidden] {
    display: none;
  }
  @media (min-width: 820px) {
    .hp__panel {
      grid-template-columns: minmax(0, 27rem) minmax(0, 1fr);
      gap: var(--space-12);
      align-items: center;
    }
  }

  .hp__paper {
    position: relative;
    margin: 0 14px;
    max-width: 27rem;
    justify-self: center;
    width: calc(100% - 28px);
    background: #fff;
    border-radius: 3px;
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.25),
      0 28px 50px -18px rgba(0, 0, 0, 0.6);
  }
  .hp__paper img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 3px;
  }
  .hp__sticker {
    position: absolute;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    margin: -13px 0 0 -13px;
    border-radius: 50%;
    background: var(--color-signal);
    color: var(--color-signal-ink);
    border: 2px solid var(--color-deep);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.85rem;
    line-height: 1;
  }
  .hp__sticker--inline {
    position: static;
    margin: 0;
    grid-row: 1 / span 3;
    border-color: transparent;
  }

  .hp__facts {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
  }
  .hp__facts li {
    display: grid;
    grid-template-columns: 26px minmax(0, 1fr);
    column-gap: var(--space-4);
    align-items: start;
    padding-block: var(--space-4);
    border-top: 1px solid rgba(255, 255, 255, 0.18);
  }
  .hp__facts li:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .hp__facts p {
    grid-column: 2;
    margin: 0;
  }
  .hp__k {
    font-size: 0.9rem;
    color: #b9d2c4;
  }
  .hp__v {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.3rem, 2.6vw, 1.75rem);
    line-height: 1.15;
    color: #fff;
  }
  .hp__s {
    font-size: 0.95rem;
    color: #cfe3d7;
  }

  .hp__foot {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-10);
    padding-top: var(--space-8);
    border-top: 1px solid rgba(255, 255, 255, 0.18);
  }
  @media (min-width: 820px) {
    .hp__foot {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
    }
  }
  .hp__foot p {
    color: #cfe3d7;
    font-size: 1.08rem;
    max-width: 40rem;
    margin: 0;
  }
  .hp__button {
    justify-self: start;
    background: var(--color-signal);
    color: var(--color-signal-ink);
    border-color: var(--color-signal);
  }
  .hp__button:hover {
    background: var(--color-signal-hover);
    border-color: var(--color-signal-hover);
    color: var(--color-signal-ink);
  }
  .hp__button:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 2px;
  }
  @media print {
    .hp {
      display: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-handbook-preview]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role=tab]'));
    const select = (tab: HTMLButtonElement, focus = false) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(t.getAttribute('aria-controls')!);
        if (panel) panel.hidden = !on;
      });
      if (focus) tab.focus();
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (e) => {
        const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!step) return;
        e.preventDefault();
        select(tabs[(i + step + tabs.length) % tabs.length], true);
      });
    });
    // fetch the other two pages once the visitor reaches the preview, so switching is instant
    const warm = new IntersectionObserver((entries) => {
      if (!entries.some((en) => en.isIntersecting)) return;
      warm.disconnect();
      tabs.forEach((t) => {
        if (t.dataset.image) new Image().src = t.dataset.image;
      });
    });
    warm.observe(root);
  });

  // "Maak het voor mijn adres": jump to the form and put the cursor in the first field
  document.querySelectorAll<HTMLAnchorElement>('[data-focus-form]').forEach((link) => {
    link.addEventListener('click', () => {
      const target = document.querySelector<HTMLElement>(link.hash);
      const input = target?.querySelector<HTMLInputElement>('input[name=postcode]');
      if (input) setTimeout(() => input.focus({ preventScroll: true }), 500);
    });
  });
</script>
