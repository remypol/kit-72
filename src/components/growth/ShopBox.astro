---
/** Where-to-buy box at the top of a product category page. */
import Icon from '../ui/Icon.astro';
import { shopCopy, shopLinks } from '../../data/shop';

interface Props {
  locale: 'nl' | 'de';
  category: string;
}
const { locale, category } = Astro.props;
const rows = shopLinks[locale][category] ?? [];
const c = shopCopy[locale];
---

{rows.length > 0 && (
  <aside class="shopbox not-prose" data-placement="shopbox" aria-labelledby="shopbox-title">
    <h2 id="shopbox-title" class="shopbox__title">{c.title}</h2>
    <ul class="shopbox__rows">
      {rows.map((row) => (
        <li>
          <span class="shopbox__what">{row.what}</span>
          <span class="shopbox__links">
            {row.links.map((l) => (
              <a href={l.url} class="shopbox__link">
                <span class="sr-only">{c.at} </span>{l.label}
                <Icon name="ExternalLink" size={14} />
              </a>
            ))}
          </span>
        </li>
      ))}
    </ul>
    <p class="shopbox__note">{c.note}</p>
  </aside>
)}

<style>
  .shopbox {
    margin-block: var(--space-6) var(--space-8);
    background: var(--color-bg-secondary);
    border: 1.5px solid var(--color-text-primary);
    border-radius: var(--radius-lg);
    padding: var(--space-5) var(--space-5) var(--space-4);
  }
  .shopbox__title {
    font-size: 1.15rem;
    padding-bottom: var(--space-3);
    border-bottom: 2px solid var(--color-text-primary);
  }
  .shopbox__rows li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }
  .shopbox__what {
    font-weight: 650;
  }
  .shopbox__links {
    display: flex;
    gap: var(--space-2);
  }
  .shopbox__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 40px;
    padding: 0 var(--space-3);
    background: var(--color-signal);
    color: var(--color-signal-ink);
    font-weight: 650;
    font-size: 0.95rem;
    border-radius: var(--radius-md);
    box-shadow: inset 0 -2px 0 rgba(0, 0, 0, 0.18);
  }
  .shopbox__link:hover {
    background: var(--color-signal-hover);
    color: var(--color-signal-ink);
  }
  .shopbox__note {
    margin-top: var(--space-3);
    font-size: 0.85rem;
    color: var(--color-text-tertiary);
  }
  @media print {
    .shopbox {
      display: none;
    }
  }
</style>
