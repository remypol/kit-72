---
/**
 * The Kit-72 mark: a carry case with a handle, carrying the number 72.
 * Keep the paths in step with scripts/brand.mjs, which generates the
 * favicon, app icons and share images from the same drawing.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 34, class: className = '' } = Astro.props;
---

<svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 64 64" class={className} aria-hidden="true" focusable="false">
  <path d="M23 15V11.5a5.5 5.5 0 0 1 5.5-5.5h7a5.5 5.5 0 0 1 5.5 5.5V15" fill="none" stroke="#0a7a43" stroke-width="5"></path>
  <rect x="4" y="13" width="56" height="47" rx="9" fill="#0a7a43"></rect>
  <g fill="none" stroke="#fff" stroke-width="6" stroke-linejoin="miter" stroke-miterlimit="2.2">
    <path d="M12.5 26.5H28.2L19.2 49.6"></path>
    <path d="M36.4 33.6a7.1 7.1 0 0 1 14.2 0c0 4.6-3.6 7.2-12.6 14.9H52"></path>
  </g>
</svg>
