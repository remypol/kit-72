{
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/pagefind/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/favicon.svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/es/escenarios/apagon-espana-2024/",
      "destination": "/es/escenarios/apagon-espana-2025/",
      "permanent": true
    },
    {
      "source": "/es/escenarios/apagon-espana-2024",
      "destination": "/es/escenarios/apagon-espana-2025/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "nl.*"
        }
      ],
      "missing": [
        {
          "type": "query",
          "key": "choose"
        }
      ],
      "destination": "/nl/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "de.*"
        }
      ],
      "missing": [
        {
          "type": "query",
          "key": "choose"
        }
      ],
      "destination": "/de/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "es.*"
        }
      ],
      "missing": [
        {
          "type": "query",
          "key": "choose"
        }
      ],
      "destination": "/es/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "x-vercel-ip-country",
          "value": "(NL|BE)"
        }
      ],
      "missing": [
        {
          "type": "query",
          "key": "choose"
        }
      ],
      "destination": "/nl/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "x-vercel-ip-country",
          "value": "(DE|AT|CH)"
        }
      ],
      "missing": [
        {
          "type": "query",
          "key": "choose"
        }
      ],
      "destination": "/de/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "x-vercel-ip-country",
          "value": "(ES)"
        }
      ],
      "missing": [
        {
          "type": "query",
          "key": "choose"
        }
      ],
      "destination": "/es/",
      "permanent": false
    }
  ],
  "functions": {
    "api/handbook.js": {
      "includeFiles": "handbook/{data,lib,pages}/**",
      "maxDuration": 120
    },
    "api/handbook-request.js": {
      "includeFiles": "handbook/{data,lib}/**",
      "maxDuration": 30
    }
  }
}
